# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# editors
.vscode/
.idea/

# Package 4 — per-run mad-lib answers (regenerated each demo run, not a shared artifact).
# data/studio_scores.csv is NOT ignored: Package 5 reads it, so it needs to be committed.
studio_scoring/mandate_live.yaml
# Raw CMU Book Summary Dataset (17MB, third-party download) -- build_cmu_cache.py fetches this
# itself. Only the small matched-subset output (studio_scoring/cmu_summaries.csv) is committed.
studio_scoring/.cmu_cache/
# scoring_agent.py run bookkeeping (batch-resume manifests, per-run failure logs) -- working
# artifacts local to a specific run, not shared data. data/studio_scores.csv itself is not ignored.
data/studio_scores_batches.json
data/studio_scores_failures.txt
# site/data/ is a local-only data snapshot used for `railway up` CLI deploys
# (which only upload site/'s own contents, not ../data/) -- not a source of
# truth, never commit it, see site/README.md
site/data/
